PORT=3000

DATABASE_URL=postgresql://user:password@localhost:5432/aurex
# TLS para o banco. Com true, o certificado É VERIFICADO — antes esta mesma
# flag ligava criptografia SEM verificar, ou seja, aberta a man-in-the-middle
# enquanto parecia segura.
DATABASE_SSL=false
# Certificado da CA, quando o banco usa uma CA própria (conteúdo PEM).
DATABASE_SSL_CA=
# Escape para certificado auto-assinado em desenvolvimento. Desliga a
# verificação — nunca use em produção.
DATABASE_SSL_INSECURE=false
AUREX_PUBLIC_BASE_URL=https://api.aurexai.com
# Gere com: openssl rand -base64 48  (mínimo 32 caracteres; o servidor recusa subir com o padrão)
AUREX_JWT_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.aurexai.com/auth/google/callback

# modelo temporario pois por enquanto to fazendo meu proprio modelo.
DEEPSEEK_API_KEY=


# Chaves de API do Aurex, separadas por vírgula. Gere com: openssl rand -hex 32
# O servidor recusa subir com valor de exemplo ou chave com menos de 24 caracteres.
AUREX_API_KEYS=

# ---------- Sandbox de código (execução em container Docker) ----------
# DESLIGADA por padrão. Ao ligar, o servidor SE RECUSA a subir se
# AUREX_API_KEYS estiver vazio, se AUREX_JWT_SECRET for o valor de exemplo,
# se o bind for público sem opt-in, ou se estiver rodando como root.
AUREX_SANDBOX_ENABLED=false
AUREX_SANDBOX_IMAGE=aurex/sandbox:1
AUREX_SANDBOX_ROOT=/var/lib/aurex/sandbox

# Endereço em que o servidor escuta. Padrão local — a versão anterior
# escutava em todas as interfaces apesar do log dizer 127.0.0.1.
AUREX_BIND_HOST=127.0.0.1

# Limites de cada execução
AUREX_SANDBOX_MEMORY=1g
AUREX_SANDBOX_CPUS=1.0
AUREX_SANDBOX_PIDS=256
AUREX_SANDBOX_TIMEOUT_MS=120000
AUREX_SANDBOX_MAX_TIMEOUT_MS=600000
AUREX_SANDBOX_MAX_OUTPUT_BYTES=262144
AUREX_SANDBOX_MAX_WORKSPACE_MB=512
AUREX_SANDBOX_SESSION_TTL_MS=86400000
AUREX_SANDBOX_MAX_CONCURRENT=2
AUREX_SANDBOX_RATE_PER_MIN=20

# Rede dentro do container, POR EXECUÇÃO. Com false, "npm install" e
# "pip install" falham e o agente fica limitado ao que a imagem já traz.
# Com true, cada chamada decide se quer rede (network=true); as demais
# continuam com --network none. Ligue se quiser que o agente monte projetos
# de código de verdade, sabendo que o container processa conteúdo lido de
# páginas web e rede é canal de saída.
AUREX_SANDBOX_ALLOW_NETWORK=false

# Processos de longa duração (servidor de preview) — opt-in SEPARADO da
# rede, porque publicar porta implica bridge E um listener alcançável na
# loopback do host. É o que permite ao agente abrir o que construiu no
# navegador e tirar screenshot para conferir.
AUREX_SANDBOX_ALLOW_SERVICES=false
AUREX_SANDBOX_SERVICE_PORT_START=47000
AUREX_SANDBOX_SERVICE_PORT_COUNT=40
AUREX_SANDBOX_SERVICE_TTL_MS=1800000
AUREX_SANDBOX_SERVICE_BOOT_MS=25000
AUREX_SANDBOX_MAX_SERVICES=5

# Escapes explícitos (use só se souber o que está fazendo)
AUREX_SANDBOX_ALLOW_PUBLIC_BIND=false
AUREX_SANDBOX_ALLOW_ROOT=false

# Destinos permitidos para o código de autorização OAuth (allowlist exata).
# A extensão usa https://<id-da-extensao>.chromiumapp.org/callback
AUREX_ALLOWED_REDIRECT_URIS=

# Origens web permitidas no CORS. Vazio NÃO é mais curinga: por padrão só
# passam a extensão (chrome-extension://) e requisições sem Origin. Um site
# qualquer que o usuário visite não alcança mais este servidor.
AUREX_ALLOWED_ORIGINS=

# Limite de abuso do proxy do modelo (a rota que gasta dinheiro). Um agente em
# laço faz muitas chamadas legítimas, então o teto é generoso — ele impede o
# descontrolado, não o uso normal.
AUREX_CHAT_RATE_PER_MIN=60
AUREX_CHAT_MAX_TOKENS=16384
